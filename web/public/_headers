# Response headers for Cloudflare (Workers static assets or Pages).
# Pyodide and Z3 need 'wasm-unsafe-eval' to compile their WebAssembly modules.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/pyodide/*
  Cache-Control: public, max-age=31536000, immutable
